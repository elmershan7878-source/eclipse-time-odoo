<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eclipse_risk_check_list" model="ir.ui.view">
        <field name="name">eclipse.risk.check.list</field>
        <field name="model">eclipse.risk.check</field>
        <field name="arch" type="xml">
            <list string="Checks" create="false">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="area"/>
                <field name="available" widget="boolean"/>
                <field name="weight"/>
                <field name="signal_count" string="Open signals"/>
                <field name="last_run"/>
                <field name="last_error" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_eclipse_risk_check_form" model="ir.ui.view">
        <field name="name">eclipse.risk.check.form</field>
        <field name="model">eclipse.risk.check</field>
        <field name="arch" type="xml">
            <form string="Check" create="false">
                <header>
                    <button name="action_reset_weight" type="object" string="Reset learned weight"
                            invisible="weight == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_signals" type="object" class="oe_stat_button" icon="fa-bell">
                            <field name="signal_count" widget="statinfo" string="Open signals"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="area"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="available"/>
                            <field name="required_model" invisible="not required_model"/>
                        </group>
                        <group>
                            <field name="threshold"/>
                            <field name="grace_days"/>
                            <field name="confidence"/>
                            <field name="weight"/>
                            <field name="last_run"/>
                            <field name="last_error" invisible="not last_error"/>
                        </group>
                    </group>
                    <group string="What it checks">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eclipse_risk_check" model="ir.actions.act_window">
        <field name="name">Checks</field>
        <field name="res_model">eclipse.risk.check</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
