<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_risk_scan" model="ir.cron">
            <field name="name">Risk Monitor: scan</field>
            <field name="model_id" ref="model_eclipse_risk_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_risk_digest" model="ir.cron">
            <field name="name">Risk Monitor: daily digest</field>
            <field name="model_id" ref="model_eclipse_risk_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:30:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
